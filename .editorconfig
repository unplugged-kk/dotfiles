# EditorConfig - shared editor defaults across nvim, VS Code, Cursor, WezTerm.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Nix convention is 2-space indent; shell is 2-space too.
[*.nix]
indent_size = 2

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab

# JSON files often arrive 2-space; keep consistent.
[*.json]
indent_size = 2

[*.jsonc]
indent_size = 2

[*.toml]
indent_size = 2

[*.lua]
indent_size = 2

# WezTerm config is Lua but often formatted with 2 spaces.
[*.lua]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
